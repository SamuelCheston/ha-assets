{
  "name": "ha-assets",
  "version": "1.0.0",
  "description": "Minecraft 竞技对局平台 SVG 视觉素材库：MatchCoreArena-Client 与 SamuelClient 共用。纯矢量、单强调色扁平几何风。",
  "consumers": [
    "MatchCoreArena-Client",
    "SamuelClient"
  ],
  "style": {
    "accent": "#e94560",
    "semantic": {
      "ok": "#4caf50",
      "warn": "#f59e0b",
      "danger": "#ef5350",
      "info": "#3b82f6"
    },
    "backgrounds": {
      "base": "#0a0c10",
      "panel": "#10141a",
      "raised": "#171d26"
    },
    "strokeWidth": {
      "icon": 2,
      "illustration": 1.5
    },
    "cssVars": {
      "--ha-accent": "#e94560",
      "--ha-ok": "#4caf50",
      "--ha-warn": "#f59e0b",
      "--ha-danger": "#ef5350",
      "--ha-info": "#3b82f6",
      "--ha-base": "#0a0c10",
      "--ha-panel": "#10141a",
      "--ha-raised": "#171d26",
      "--ha-edge": "#232b37",
      "--ha-ink": "#e9edf3",
      "--ha-ink-muted": "#96a1b3",
      "--ha-ink-faint": "#5c6879"
    },
    "rules": [
      "无渐变 / 无玻璃拟态 / 无写实插画 / 无 3D / 无阴影",
      "线宽：图标 2px，插画与徽章 1.5px",
      "着色仅 currentColor 与 var(--ha-*)（均带回退值）",
      "全部带 viewBox，无内联 style，无外链字体"
    ]
  },
  "groups": {
    "icons": "icons/ — 导航与动作图标（24 网格，16/24/32 变体）",
    "states": "states/ — 空状态与错误插画（240×160）",
    "flow": "flow/ — 对局流阶段图形（Stepper 节点）",
    "tiers": "tiers/ — 段位徽章（160×160，纯装饰递进）",
    "modes": "modes/ — 玩法规模与占位符（24 网格）",
    "patterns": "patterns/ — 低透明度背景纹理（平铺单元）",
    "brand": "brand/ — 应用标记（160×160）"
  },
